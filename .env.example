# Local development only. WebDev injects its managed MySQL DATABASE_URL at runtime.
# For plain HTTP local browsing, run `npm run api:dev:http` to opt into Lax/non-Secure cookies.
DATABASE_URL=mysql://labtrack_local:CHANGE_ME@127.0.0.1:3306/labtrack_dev
LABTRACK_LOCAL_DATABASE_URL=mysql://labtrack_local:CHANGE_ME@127.0.0.1:3306/labtrack_dev
LABTRACK_TEST_DATABASE_URL=mysql://labtrack_local:CHANGE_ME@127.0.0.1:3306/labtrack_test
LABTRACK_MIGRATION_TARGET=local
LABTRACK_PROVISION_TARGET=local
MYSQL_SSL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=labtrack_session
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=28800000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
TEACHER_NAME=
TEACHER_EMAIL=
TEACHER_PASSWORD=
MANUS_PREVIEW_HOST=
